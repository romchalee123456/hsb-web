generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model file {
  fileid         Int      @id @default(autoincrement())
  fileName       String   @db.VarChar(500)
  filePath       String   @db.VarChar(500)
  statusId       Int
  createOn       DateTime @default(now())
  houseDetailId  Int
  backUpStatus   Int
  fileBackupPath String   @db.VarChar(500)
  reportSelected Boolean @default(false)

  housedetail housedetail @relation(fields: [houseDetailId], references: [houseDetailid])
}

model housedetail {
  houseDetailid     Int      @id @default(autoincrement())
  createOn          DateTime @default(now())
  houseDetailNameId Int
  periodDetailid    Int
  houseDetailStatus Int?
  houseDetailname housedetailname @relation(fields: [houseDetailNameId], references: [houseDetailNameid])
  periodDetail periodDetail @relation(fields: [periodDetailid], references: [periodDetailid])
  files           file[]
  notifications notifications[] 
  notificationsHistory notificationsHistory[] 
}

model housedetailname {
  houseDetailNameid Int      @id @default(autoincrement())
  createOn          DateTime @default(now())
  houseDetailName   String   @db.VarChar(500)

  housedetails housedetail[]
}

model period {
  periodid       Int      @id @default(autoincrement())
  projectid      Int
  description    String   @db.VarChar(500)
  createOn       DateTime @default(now()) @db.Timestamp(6)
  periodStatusId Int
  periodsamount          Decimal?  @db.Decimal(10, 0)
  
  project    project    @relation(fields: [projectid], references: [projectid])
  periodStatus periodStatus @relation(fields: [periodStatusId], references: [periodStatusId])

  periodDetail periodDetail[]
}

model periodDetail {
  periodDetailid       Int      @id @default(autoincrement())
  periodid              Int     
  projectid            Int
  description    String   @db.VarChar(500)
  createOn       DateTime @default(now()) @db.Timestamp(6)
  periodDetailStatusId Int
  periodnameid   Int

  periodname periodname @relation(fields: [periodnameid], references: [periodNameid])
  period period @relation(fields: [periodid], references: [periodid])
  periodDetailStatus periodDetailStatus @relation(fields: [periodDetailStatusId], references: [periodDetailStatusId])

  housedetail housedetail[]
}

model periodStatus {
  periodStatusId Int @id @default(autoincrement())
  periodStatusName String @db.VarChar(500)
  period period[]
}

model periodDetailStatus {
  periodDetailStatusId Int @id @default(autoincrement())
  periodDetailStatusName String @db.VarChar(500)
  periodDetail periodDetail[]
}


model periodname {
  periodNameid Int      @id @default(autoincrement())
  createOn     DateTime @default(now())
  periodName   String   @db.VarChar(500)

  periodDetail periodDetail[]
}

model project {
  projectid       Int       @id @default(autoincrement())
  projectName     String?   @db.VarChar(500)
  projectCode     String?   @db.VarChar(500)
  description     String?   @db.VarChar(500)
  createOn        DateTime? @default(now()) @db.Timestamp(6)
  amount          Decimal?  @db.Decimal(10, 0)
  userid          Int?
  projectStatusid Int?
  responseid      Int?
  locationName    String?   @db.VarChar(255)
  locationCode    String?   @db.VarChar(255)
  lat             Decimal?    @db.Decimal(9, 6)
  lon             Decimal?    @db.Decimal(9, 6)
  customerid      Int?
  


  periods period[]

}


model user {
  id          Int      @id @default(autoincrement())
  firstname   String?  @db.VarChar(50)
  lastname    String?  @db.VarChar(50)
  email       String   @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  created_on  DateTime @default(now()) @db.Timestamp(6)
  role        Int?
  teamName    String?  @db.VarChar(100)
  phoneNumber String?  @db.VarChar(50)
  userLineNotificationsid     String?   @db.VarChar(500)
}

model customer {
  customerid Int @id @default(autoincrement())
  house_Detail_id      Int?
  customerFirstname String? @db.VarChar(255)
  customerLastname String? @db.VarChar(255) 
  customerLine String? @db.VarChar(255)
  customerPhone String?  @db.VarChar(50)
  customerAddress String? @db.VarChar(500)

}

model notifications {
  notificationsId Int @id @default(autoincrement())
  description String? @db.VarChar(255) 
  notificationsTypeId      Int
  createBy      Int?
  approver      Int?
  actionNotificationsId      Int
  houseDetailId  Int
  actionNotifications actionNotifications @relation(fields: [actionNotificationsId], references: [actionNotificationsId])
  notificationsType notificationsType @relation(fields: [notificationsTypeId], references: [notificationsTypeId])
  housedetail housedetail @relation(fields: [houseDetailId], references: [houseDetailid])

}
model notificationsHistory {
  notificationsHistoryId Int @id @default(autoincrement())
 description String? @db.VarChar(255) 
  notificationsTypeId      Int
  createBy      Int?
  approver      Int?
  actionNotificationsId      Int
  houseDetailId  Int
  actionNotifications actionNotifications @relation(fields: [actionNotificationsId], references: [actionNotificationsId])
  notificationsType notificationsType @relation(fields: [notificationsTypeId], references: [notificationsTypeId])
  housedetail housedetail @relation(fields: [houseDetailId], references: [houseDetailid])

}

model actionNotifications {
  actionNotificationsId Int      @id @default(autoincrement())
  createOn     DateTime @default(now())
  actionNotificationsName   String   @db.VarChar(500)
  
  notifications notifications[]
  notificationsHistory notificationsHistory[]
}

model notificationsType {
  notificationsTypeId Int      @id @default(autoincrement())
  createOn     DateTime @default(now())
  notificationsTypeName   String   @db.VarChar(500)

  notifications notifications[]
  notificationsHistory notificationsHistory[]
}

model lineeventhook {

  lineeventhookId Int      @id @default(autoincrement())
  lineeventhookText   String   @db.VarChar(500)

}